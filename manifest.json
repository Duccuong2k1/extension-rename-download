{
  "manifest_version": 3,
  "name": "Flow Bulk Rename & Download",
  "version": "1.0.0",
  "description": "Tải toàn bộ ảnh trong dự án Google Flow, đổi tên theo thứ tự đang hiển thị.",
  "permissions": ["downloads", "activeTab", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Flow Bulk Rename & Download" }
}
